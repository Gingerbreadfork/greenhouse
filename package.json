{
  "name": "greenhouse",
  "version": "0.3.1",
  "description": "A torrent client for Linux and Windows that looks good and keeps everything a click or a keystroke away.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gingerbreadfork/greenhouse"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "ARCH=$(uname -m) NO_STRIP=true tauri build",
    "preview:dev": "vite --config vite.preview.config.ts",
    "preview:build": "vite build --config vite.preview.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^26.1.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}