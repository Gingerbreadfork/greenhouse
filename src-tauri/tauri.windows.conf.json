{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent file",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    }
  }
}
