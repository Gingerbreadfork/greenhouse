{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greenhouse",
  "version": "0.3.2",
  "identifier": "dev.greenhouse.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Greenhouse",
        "label": "main",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": null,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxOTI0MUJFMzI0NzAwQTkKUldTcEFFY3l2a0dTOFVaQ2IyWUhNQWJYT1BpV2tIT3lnVXpIazlmcG1taUM1bEE4TkYwdERMM24K",
      "endpoints": [
        "https://github.com/Gingerbreadfork/greenhouse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A torrent client",
    "longDescription": "Greenhouse is a torrent client with bulk tracker management.",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "greenhouse.desktop"
      },
      "rpm": {
        "depends": [],
        "desktopTemplate": "greenhouse.desktop"
      }
    }
  }
}